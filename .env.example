# Build-time overrides for apps/web/site.config.ts (all optional; the file is the main config).
# There are no secrets: the app is static and these values end up in public files.

# Production origin, e.g. https://pdf.example.org (canonical URLs, sitemap, Open Graph).
SITE_URL=
# Product name and repository, if you do not want to edit site.config.ts.
SITE_NAME=
SITE_REPO_URL=
# Cloudflare Web Analytics beacon token. Empty = analytics OFF (the default).
# When set, the CSP allows exactly static.cloudflareinsights.com and cloudflareinsights.com.
SITE_CF_ANALYTICS_TOKEN=
