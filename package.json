{
  "name": "pdf-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Free, private PDF tools that run entirely in your browser.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @pdf-tools/web dev",
    "build": "pnpm --filter @pdf-tools/web build",
    "preview": "pnpm --filter @pdf-tools/web preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "pnpm --filter @pdf-tools/core exec vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --project=chromium --project=webkit",
    "fixtures": "node packages/core/fixtures/generate.ts",
    "fuzz": "node packages/core/fuzz/fuzz.ts",
    "licenses:check": "node scripts/check-licenses.ts",
    "images": "node scripts/generate-images.ts",
    "check:launch": "node scripts/check-launch.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
